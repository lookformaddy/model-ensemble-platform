# Model Ensemble Platform — environment overrides (copy to .env to use).
# All settings have production defaults; only override what you need.

# Promotion gates
MEP_ACCURACY_FLOOR=0.78
MEP_AUC_FLOOR=0.82
MEP_BEAT_SINGLE_DELTA=0.005
MEP_DIVERSITY_FLOOR=0.05
MEP_MAX_LATENCY_MS=200
MEP_MAX_MEMBERS=8
MEP_MAX_SIZE_KB=2048
MEP_STABILITY_MAX_STD=0.02
MEP_MIN_EVAL_CASES=100

# Serving
MEP_MEMBER_TIMEOUT_MS=100
MEP_SERVE_BUDGET_MS=200

# Drift
MEP_PSI_WARN=0.10
MEP_PSI_CRITICAL=0.25
MEP_KS_WARN=0.10
MEP_AGREEMENT_DRIFT_WARN=0.10

# Deployment
MEP_CANARY_FRACTION=0.10
MEP_SHADOW_AGREEMENT_FLOOR=0.85

# Data / training
MEP_SEED=42
MEP_N_SAMPLES=1200
MEP_N_FEATURES=8
MEP_TEST_FRACTION=0.2
MEP_N_FOLDS=5
